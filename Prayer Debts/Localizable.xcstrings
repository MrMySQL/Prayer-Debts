            "value" : "أفضل وقت للبدء\nكان منذ سنوات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beste Zeit anzufangen\nwar vor Jahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mejor momento para empezar\nfue hace años."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le meilleur moment pour commencer\nétait il y a des années."
          }
