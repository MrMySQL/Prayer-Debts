    "This will permanently delete all your prayer data. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جميع بيانات صلواتك نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Ihre Gebetsdaten dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos los datos de tus oraciones. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement toutes vos données de prière. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà permanentemente tutti i dati delle tue preghiere. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての礼拝データが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 예배 데이터가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente todos os seus dados de oração. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все данные о ваших молитвах будут безвозвратно удалены. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це назавжди видалить усі ваші дані про молитви. Цю дію неможливо скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除您所有的礼拜数据，此操作无法撤销。"
          }
        }
      }
    },
    "This will update your total debt for all prayers to %@ each. Your completed count won't change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تحديث إجمالي دَينك لجميع الصلوات إلى %@ لكل صلاة. لن يتغير عدد الصلوات المُقضاة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird Ihre Gesamtschuld für alle Gebete auf jeweils %@ aktualisiert. Ihre verrichtete Anzahl bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto actualizará tu deuda total de todas las oraciones a %@ cada una. Tu recuento completado no cambiará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela mettra à jour votre dette totale pour toutes les prières à %@ chacune. Votre nombre de prières accomplies ne changera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo aggiornerà il debito totale di tutte le preghiere a %@ ciascuna. Il conteggio delle preghiere completate non cambierà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての礼拝の合計をそれぞれ %@ に更新します。完了済みの数は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 예배의 총 미수행 수가 각각 %@으로 업데이트됩니다. 수행 완료 수는 변경되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso atualizará sua dívida total de todas as orações para %@ cada. Sua contagem de orações realizadas não será alterada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Общий долг по всем молитвам будет обновлён до %@ каждая. Количество выполненных молитв не изменится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загальний борг за всіма молитвами буде оновлено до %@ кожна. Кількість виконаних молитов не зміниться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将把所有拜功的总欠缺更新为每项 %@。已完成的数量不会改变。"
          }
        }
      }
    },
